# Car Service Management System - Environment Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=car_service_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Application Settings
APP_NAME=Car Service Management System
APP_VERSION=1.0.0
DEBUG=True

# Business Information
COMPANY_NAME=AutoCare Service Center
COMPANY_ADDRESS=123 Service Street, Auto City, AC 12345
COMPANY_PHONE=(555) 123-4567
COMPANY_EMAIL=info@autocare.com

# Tax Settings (adjust to your local tax rate)
TAX_RATE=0.00
TAX_NAME=Sales Tax

# Invoice Settings
INVOICE_PREFIX=INV
ORDER_PREFIX=SO
PAYMENT_TERMS_DAYS=30

# Currency Settings
CURRENCY_SYMBOL=$
CURRENCY_CODE=USD

# Labor Rate
DEFAULT_LABOR_RATE=75.00

# Session Settings
SESSION_TIMEOUT_MINUTES=60
